# Public site URL (no trailing slash). Used for canonical URLs, Open Graph and sitemap.
VITE_SITE_URL=https://your-domain.com

# Contact form endpoint. Receives a JSON POST: { name, email, projectType, budget, message }.
# Works out of the box with Formspree (https://formspree.io/f/xxxxxxx), Getform, Basin,
# or your own serverless function. Leave empty to show an "email me directly" fallback.
VITE_CONTACT_ENDPOINT=
